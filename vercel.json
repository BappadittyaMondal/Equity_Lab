{
  "version": 2,
  "outputDirectory": "frontend_deploy",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://equity-lab-c90s.onrender.com/api/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/js/$1"
    },
    {
      "source": "/style.css",
      "destination": "/style.css"
    },
    {
      "source": "/data/(.*)",
      "destination": "/data/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
