# ==============================================================================
# IERL AI EQUITY OS — MULTI-PROVIDER API CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' or 'API_KEYS_CONFIG.env' and fill in your keys.
# DO NOT COMMIT ACTUAL API KEYS TO GIT OR PUBLIC HOSTINGER PUBLIC_HTML.
# ==============================================================================

# Active LLM Provider Selection (gemini | groq | deepseek | claude)
ACTIVE_LLM_PROVIDER=gemini

# 1. Google Gemini API (Free Tier: 15 RPM / 1M TPM)
GEMINI_API_KEY=YOUR_FREE_GEMINI_API_KEY_HERE

# 2. Groq Llama-3 API (Free Tier: Ultra-low latency)
GROQ_API_KEY=YOUR_FREE_GROQ_API_KEY_HERE

# 3. Anthropic Claude API (Paid / Premium Tier)
ANTHROPIC_API_KEY=YOUR_CLAUDE_API_KEY_HERE

# 4. DeepSeek AI API (Alternative LLM)
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE

# 5. Financial Data APIs
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY_HERE
ANGELONE_SMART_API_KEY=YOUR_ANGELONE_SMART_API_KEY_HERE
ANGELONE_CLIENT_CODE=YOUR_CLIENT_CODE_HERE
ANGELONE_PASSWORD=YOUR_PASSWORD_HERE
ANGELONE_TOTP_SECRET=YOUR_TOTP_SECRET_HERE

# Backend CORS Production Allowed Origin
ALLOWED_ORIGIN=https://yourdomain.com

# Set production in hosted deployments. In production, local dotenv files are
# intentionally ignored; use the platform's secret manager instead.
IERL_ENVIRONMENT=production
# Leave false unless deliberately migrating a legacy local file to `.env`.
IERL_LOAD_LEGACY_API_KEYS_FILE=false

# Optional API protection. When true, non-health API requests require the
# X-API-Key header to match API_KEY_SECRET.
REQUIRE_AUTH=false
API_KEY_SECRET=GENERATE_A_LONG_RANDOM_SECRET
TRUST_PROXY_HEADERS=false

# A2 options analytics are deliberately disabled until validated with live
# option-chain data and a documented backtest.
ENABLE_OPTIONS_A2=false

# Point-in-time research data storage & Relational DB.
# Set to Postgres URL in production (e.g. Neon/Render), defaults to sqlite:////tmp/equity_lab.db in Vercel serverless
DATABASE_URL=postgresql://user:password@host:5432/equity_lab
DATA_STORE_PATH=data/ierl_equity.sqlite3
DATA_WRITE_API_KEY=GENERATE_A_SEPARATE_LONG_RANDOM_WRITE_KEY

