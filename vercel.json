{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "frontend_deploy/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend_deploy/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend_deploy/$1"
    }
  ]
}
