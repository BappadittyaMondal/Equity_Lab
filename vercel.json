{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend_deploy/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/js/(.*)",
      "dest": "frontend_deploy/js/$1"
    },
    {
      "src": "/style.css",
      "dest": "frontend_deploy/style.css"
    },
    {
      "src": "/data/(.*)",
      "dest": "frontend_deploy/data/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend_deploy/index.html"
    }
  ]
}
